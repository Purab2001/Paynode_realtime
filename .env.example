# Realtime (chat) server. Needs a host that keeps a process running: Render, Railway, Fly.io, a VPS.
# Vercel functions can't hold WebSocket connections open, so this does NOT go on Vercel.
PORT=5001

# Comma-separated list of browser origins allowed to connect (the frontend URL).
CLIENT_URL=http://localhost:5173

# Same database and Firebase project as the backend.
MONGODB_URI=
MONGODB_DB=paynode
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Shared with the backend (REALTIME_SECRET there). Lets the API disconnect a deactivated user immediately.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REALTIME_SECRET=
